<?xml version="1.1"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="four_wheels_robot">
    
    <xacro:property name="wheel_radius" value="0.0425"/>
    <xacro:property name="wheel_length" value="0.02"/>

    <!-- Include control definitions -->
    <!-- <xacro:include filename="$(find four_wheels_robot)/urdf/ros2_wheel_controllers.xacro"/> -->
    <xacro:include filename="$(find four_wheels_robot)/urdf/sensors.xacro"/>

    <xacro:macro name="wheel" params="prefix">
        <link name="${prefix}_wheel">
            <inertial>
                
                <mass value="0.2"/>
                <inertia ixx="0.000432" ixy="0.0" ixz="0.0" iyy="0.00081" iyz="0.0" izz="0.000432"/>
            </inertial>
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <material name="">
                    <color rgba="1.0 0.5 0.34 1.0"/>
                </material>
            </visual>
            <collision>
             <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <xacro:wheel prefix="front_left" />
    <xacro:wheel prefix="front_right"/>
    <xacro:wheel prefix="back_left"/>
    <xacro:wheel prefix="back_right" />

    <!-- Chassis -->
    <link name="base_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="10.0"/> 
            <inertia ixx="0.03157" ixy="0.0" ixz="0.0" iyy="0.21667" iyz="0.0" izz="0.24013"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.3 0.3 0.1"/>
            </geometry>
            <material name="">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.3 0.3 0.1"/>
            </geometry>
        </collision>
    </link>
    <link name="base_footprint"></link>

    <joint name="base_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <axis xyz="0.0 0.0 0.02"/>
    </joint>

    <xacro:macro name="wheel_joint" params="prefix x y r">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <origin xyz="${x} ${y} -${wheel_radius}" rpy="${r} 0 0"/>
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <axis xyz="0 1 0"/>
            <dynamics damping="0.1" friction="0.0"/>
        </joint>
    </xacro:macro>

    <xacro:wheel_joint prefix="front_left"  x="0.10" y="0.162" r="0"/>
    <xacro:wheel_joint prefix="front_right" x="0.10" y="-0.162" r="0"/>
    <xacro:wheel_joint prefix="back_left"   x="-0.10" y="0.162" r="0"/>
    <xacro:wheel_joint prefix="back_right"  x="-0.10" y="-0.162" r="0"/>

    <!--Adding a lidar-->
    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
                <material name="">
                    <color rgba="0.78 0.55 0.34 1.0"/>
                </material>           
        </visual>
    </link>

    <joint name="laser_joint" type="fixed">
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="laser_link"/>
        <axis xyz="0.0 0.0 0.0"/>
    </joint>

    <!-- Adding IMU SENSOR-->
<link name="imu_link">
  <visual>
    <geometry>
      <box size="0.05 0.05 0.05"/>
    </geometry>
  </visual>
  <collision>
    <geometry>
      <box size="0.05 0.05 0.05"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <mass value="0.1"/>
    <inertia ixx="0.002" ixy="0.0" ixz="0.002" iyy="0.002" iyz="0.0" izz="0.002"/>
  </inertial>
  
</link>

<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0.0 0.0 0.005" rpy="0.0 0.0 0.0"/>
</joint>

<!-- camera link-->
 <link name="camera_link">
    <visual>
        <geometry>
            <box size="0.01 0.04 0.02"/>
        </geometry>
        <material name="">
                <color rgba="1.0 0.6 0.9 1.0"/>
            </material>
    </visual>    
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
 </link>

 <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.15 0.0 0.03" rpy="0 0 0"/>
    
 </joint>


</robot>
