<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="dojo_robot">


  <xacro:property name="chassis_length" value="0.28"/>
  <xacro:property name="chassis_width"  value="0.25"/>
  <xacro:property name="chassis_height" value="0.08"/>

  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_width"  value="0.025"/>

  <!-- Distance between left and right wheel centers -->
  <xacro:property name="wheel_separation" value="0.25"/>

  <!-- Distance of wheels from robot center along X -->
  <xacro:property name="wheel_x" value="0.09"/>


  <material name="chassis_material">
    <color rgba="0.25 0.25 0.25 1"/>
  </material>

  <material name="wheel_material">
    <color rgba="0.03 0.03 0.03 1"/>
  </material>

  <material name="platform_material">
    <color rgba="0.65 0.65 0.65 1"/>
  </material>

  <material name="sensor_material">
    <color rgba="0.08 0.08 0.08 1"/>
  </material>


  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT                                             -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>


  <!-- ========================================================= -->
  <!-- MAIN CHASSIS                                               -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.04"/>

      <geometry>
        <box size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>
      </geometry>

      <material name="chassis_material"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.04"/>

      <geometry>
        <box size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.04"/>

      <mass value="2.5"/>

      <inertia
        ixx="0.014"
        ixy="0.0"
        ixz="0.0"
        iyy="0.019"
        iyz="0.0"
        izz="0.030"/>
    </inertial>

  </link>


  <!-- Base footprint is at ground level -->
  <joint name="base_footprint_joint"
         type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 0"/>
  </joint>


  <!-- ========================================================= -->
  <!-- WHEEL MACRO                                                -->
  <!-- ========================================================= -->

  <xacro:macro name="wheel"
               params="name x y">

    <link name="${name}">

      <visual>

        <!-- Rotate cylinder so its axis points along Y -->
        <origin rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

        <material name="wheel_material"/>

      </visual>


      <collision>

        <origin rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

      </collision>


      <inertial>

        <mass value="0.12"/>

        <inertia
          ixx="0.0002"
          ixy="0"
          ixz="0"
          iyy="0.0002"
          iyz="0"
          izz="0.0002"/>

      </inertial>

    </link>


    <joint name="${name}_joint"
           type="continuous">

      <parent link="base_link"/>
      <child link="${name}"/>

      <!-- Wheel center is 40 mm above ground -->
      <origin xyz="${x} ${y} ${wheel_radius}"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- FOUR WHEELS                                                -->
  <!-- ========================================================= -->

  <!-- Left side -->
  <xacro:wheel
    name="left_front_wheel"
    x="${wheel_x}"
    y="${wheel_separation / 2}"/>

  <xacro:wheel
    name="left_rear_wheel"
    x="-${wheel_x}"
    y="${wheel_separation / 2}"/>


  <!-- Right side -->
  <xacro:wheel
    name="right_front_wheel"
    x="${wheel_x}"
    y="-${wheel_separation / 2}"/>

  <xacro:wheel
    name="right_rear_wheel"
    x="-${wheel_x}"
    y="-${wheel_separation / 2}"/>


  <!-- ========================================================= -->
  <!-- TOP PLATFORM                                               -->
  <!-- ========================================================= -->

  <link name="top_platform">

    <visual>

      <origin xyz="0 0 0.115"/>

      <geometry>
        <box size="0.24 0.22 0.03"/>
      </geometry>

      <material name="platform_material"/>

    </visual>


    <collision>

      <origin xyz="0 0 0.115"/>

      <geometry>
        <box size="0.24 0.22 0.03"/>
      </geometry>

    </collision>


    <inertial>

      <origin xyz="0 0 0.115"/>

      <mass value="0.35"/>

      <inertia
        ixx="0.002"
        ixy="0"
        ixz="0"
        iyy="0.002"
        iyz="0"
        izz="0.003"/>

    </inertial>

  </link>


  <joint name="top_platform_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="top_platform"/>

    <origin xyz="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LIDAR                                                     -->
  <!-- ========================================================= -->

  <link name="lidar_link">

    <visual>

      <geometry>
        <cylinder
          radius="0.035"
          length="0.04"/>
      </geometry>

      <material name="sensor_material"/>

    </visual>


    <collision>

      <geometry>
        <cylinder
          radius="0.035"
          length="0.04"/>
      </geometry>

    </collision>

  </link>


  <joint name="lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.21"/>

  </joint>


  <!-- ========================================================= -->
  <!-- CAMERA                                                     -->
  <!-- ========================================================= -->

  <link name="camera_link">

    <visual>

      <geometry>
        <box size="0.05 0.04 0.04"/>
      </geometry>

      <material name="sensor_material"/>

    </visual>

  </link>


  <joint name="camera_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin xyz="0.13 0 0.17"/>

  </joint>


  <!-- ========================================================= -->
  <!-- IMU                                                        -->
  <!-- ========================================================= -->

  <link name="imu_link">

    <visual>

      <geometry>
        <box size="0.035 0.035 0.02"/>
      </geometry>

    </visual>

  </link>


  <joint name="imu_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 0.10"/>

  </joint>
  
  <gazebo reference="lidar_link">
  <sensor name="lidar_sensor" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>


    <topic>/dojo_robot/scan</topic>
    <update_rate>10</update_rate>

    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>

        <vertical>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </vertical>
      </scan>

      <range>
        <min>0.08</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>

    <always_on>true</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>



  <!-- ========================================================= -->
  <!-- GAZEBO HARMONIC DIFFERENTIAL DRIVE                        -->
  <!-- ========================================================= -->

  <gazebo>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <!-- Left side -->
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>

      <!-- Right side -->
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>cmd_vel</topic>

      <odom_topic>odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <odom_publish_frequency>30</odom_publish_frequency>

      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>

    </plugin>

  </gazebo>

</robot>